{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://urhox.dev/schemas/meta.schema.json",
  "title": "UrhoX Asset Meta",
  "description": "UrhoX 资产 Meta 文件 (*.meta)，包含资源的 UUID 和元数据",
  "type": "object",
  "required": ["uuid"],
  "properties": {
    "uuid": {
      "type": "string",
      "description": "资源唯一标识符（24 字符 URL-safe Base64）",
      "pattern": "^[A-Za-z0-9_-]{24}$",
      "examples": ["C3y7ubiP8nQLJmOepTuuvfqU", "Wjyfex0KT2watjVfL4xKfg0c"]
    },
    "group": {
      "oneOf": [
        {
          "type": "string",
          "description": "资源分组（单个）",
          "examples": ["ui", "core", "level_1"]
        },
        {
          "type": "array",
          "description": "资源分组（多个）",
          "items": {
            "type": "string"
          },
          "examples": [["ui", "core"], ["level_1", "audio"]]
        }
      ],
      "description": "资源所属分组。可以是字符串或数组"
    },
    "c_or_s": {
      "type": "string",
      "description": "前后端标识",
      "enum": ["c", "s", "cs"],
      "default": "c",
      "examples": ["c", "s", "cs"]
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "uuid": "C3y7ubiP8nQLJmOepTuuvfqU"
    },
    {
      "uuid": "C3y7ubiP8nQLJmOepTuuvfqU",
      "group": "ui",
      "c_or_s": "cs"
    },
    {
      "uuid": "D4z8vcjQ9oRMKnPfqUvwxhsW",
      "group": ["core", "ui"],
      "c_or_s": "c"
    }
  ]
}
